PORT=5001
# Optional for local try: leave MONGODB_URI unset to use in-memory storage (data is lost when the server stops).
# For production, set MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/urlshortener?retryWrites=true&w=majority
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
# On Render, set NODE_ENV=production and MONGODB_URI, plus:
# BASE_URL=https://your-backend.onrender.com
# FRONTEND_URL=https://your-frontend.vercel.app
# Both public origins are required in production. PORT may be supplied by Render.
# Accounts are the default. Set AUTH_MODE=public only for an intentionally shared demo.
AUTH_MODE=accounts
# Set to the verified number of trusted reverse-proxy hops on Render (normally 1).
# Leave 0 locally. Never use unbounded proxy trust.
TRUST_PROXY_HOPS=0
